// src/components/ScrollBehavior.js
import { useEffect } from "react";
import { useLocomotiveScroll } from "react-locomotive-scroll";

const ScrollBehavior = () => {
  const { scroll } = useLocomotiveScroll();
  
  useEffect(() => {
    if (!scroll) return;
    
    // Make sure locomotive scroll is properly initialized
    const initTimeout = setTimeout(() => {
      // Force an update to make sure scroll is initialized properly
      scroll.update();
      
      // Instead of stopping scroll on these sections, we'll just disable
      // the locomotive effects but still allow normal scrolling
      const aboutSection = document.querySelector('.about');
      const exercisesSection = document.querySelector('#exercises');
      const stressToolSection = document.querySelector('#stress-tool');
      const authSection = document.querySelector('#auth');
      const profileSection = document.querySelector('#profile');
      
      // Mark these sections for special handling instead of stopping them
      if (aboutSection) aboutSection.setAttribute('data-scroll-section', '');
      if (exercisesSection) exercisesSection.setAttribute('data-scroll-section', '');
      if (stressToolSection) stressToolSection.setAttribute('data-scroll-section', '');
      if (authSection) authSection.setAttribute('data-scroll-section', '');
      if (profileSection) profileSection.setAttribute('data-scroll-section', '');

      // Force another update after setting attributes
      scroll.update();
    }, 1000);
    
    return () => {
      clearTimeout(initTimeout);
    };
  }, [scroll]);
  
  return null;
};

export default ScrollBehavior;
